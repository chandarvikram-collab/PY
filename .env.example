# Server port
PORT=5000

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/database

# Clerk
CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder

# Replit / OIDC
ISSUER_URL=https://replit.com/oidc
REPL_ID=your-repl-id
REPLIT_DOMAINS=your-app.replit.app

# Internal services
INTERNAL_API_SECRET=replace-with-a-random-secret
REPLIT_CONNECTORS_HOSTNAME=connectors.replit.com
REPL_IDENTITY=replace-with-replit-identity
WEB_REPL_RENEWAL=replace-with-web-repl-renewal

# Object storage
PUBLIC_OBJECT_SEARCH_PATHS=/public
PRIVATE_OBJECT_DIR=/private

# Stripe
STRIPE_PREMIUM_PRICE_ID=price_placeholder

# Runtime logging
NODE_ENV=development
LOG_LEVEL=info